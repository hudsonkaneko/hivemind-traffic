<configuration>
  <input><net-file value="network.net.xml"/><route-files value="routes.rou.xml"/></input>
  <time><begin value="0"/><end value="140"/><step-length value="0.2"/></time>
  <processing><seed value="2001"/><time-to-teleport value="-1"/><collision.action value="warn"/><collision.check-junctions value="true"/></processing>
  <report><no-step-log value="true"/><duration-log.disable value="true"/></report>
</configuration>
