{
  "schema_version": 1,
  "study": "sumo-mappo-v01-fixed-lane-following",
  "environment": {
    "dt": 0.1,
    "horizon": 600,
    "speed_limit_m_s": 26.8224,
    "route_length_m": 5000.0,
    "neighbor_range_m": 120.0,
    "acceleration_min_m_s2": -4.5,
    "acceleration_max_m_s2": 2.0,
    "min_gap_m": 2.5,
    "time_headway_s": 1.5,
    "initial_speed_range_m_s": [12.0, 22.0],
    "background_depart_interval_range_s": [1.5, 3.0],
    "reward_weights": {
      "progress": 1.0,
      "headway": -0.5,
      "jerk": -0.02,
      "collision": -10.0,
      "intervention": -0.1
    }
  },
  "model": {
    "observation_size": 27,
    "state_size": 112,
    "num_agents": 4,
    "actor_hidden_sizes": [128, 128],
    "critic_hidden_sizes": [256, 256],
    "normalization": "fixed_environment_feature_scaling",
    "communication": "none",
    "action": "tanh_gaussian_normalized_acceleration",
    "critic_input": "joint_observations_alive_masks_and_agent_one_hot"
  },
  "training": {
    "algorithm": "MAPPO",
    "seed": 5101,
    "episode_seed_start": 100000,
    "episode_seed_end": 199999,
    "num_workers": 4,
    "rollout_steps": 256,
    "max_agent_transitions": 1000000,
    "max_wall_seconds": 7200,
    "device": "cpu",
    "torch_threads": 1,
    "gamma": 0.99,
    "gae_lambda": 0.95,
    "actor_lr": 0.0003,
    "critic_lr": 0.0003,
    "clip": 0.2,
    "value_clip": 0.2,
    "entropy_coef": 0.01,
    "value_coef": 0.5,
    "max_grad_norm": 0.5,
    "epochs": 4,
    "minibatch_size": 256,
    "target_kl": 0.02
  },
  "evaluation": {
    "validation_seeds": [300001, 300002, 300003, 300004, 300005, 300006, 300007, 300008, 300009, 300010],
    "test_seeds": [400001, 400002, 400003, 400004, 400005, 400006, 400007, 400008, 400009, 400010, 400011, 400012, 400013, 400014, 400015, 400016, 400017, 400018, 400019, 400020],
    "every_updates": 25,
    "selection": "accepted_then_fewer_collisions_then_fewer_overspeed_steps_then_nominal_episodes_then_reward_then_fewer_interventions",
    "acceptance": {
      "collision_vehicles": 0,
      "overspeed_steps": 0,
      "minimum_mean_progress_m": 600.0,
      "maximum_intervention_fraction": 0.05
    }
  },
  "preflight": {
    "seeds": [500001, 500002],
    "rollout_steps": 32,
    "max_wall_seconds": 300
  },
  "execution": {
    "worker_timeout_seconds": 30,
    "log_mode": "files_only",
    "rendering": false,
    "requires_explicit_train_mode": true
  }
}
