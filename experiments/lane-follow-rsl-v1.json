{
  "schema_version": 1,
  "run_name": "lane-follow-rsl-v1",
  "rsl_rl_version": "5.0.0",
  "seed": 2101,
  "route": "left_r60",
  "total_timesteps": 262144,
  "max_seconds": 7200,
  "action_mapping": "normalized_steering_signed_longitudinal",
  "runner": {
    "num_steps_per_env": 2048,
    "max_iterations": 128,
    "save_interval": 8,
    "logger": "tensorboard",
    "check_for_nan": true,
    "obs_groups": {"actor": ["policy"], "critic": ["policy"]},
    "actor": {
      "class_name": "MLPModel",
      "hidden_dims": [64, 64],
      "activation": "tanh",
      "obs_normalization": true,
      "distribution_cfg": {
        "class_name": "GaussianDistribution",
        "init_std": 0.36787944117144233,
        "std_type": "log"
      }
    },
    "critic": {
      "class_name": "MLPModel",
      "hidden_dims": [64, 64],
      "activation": "tanh",
      "obs_normalization": true,
      "distribution_cfg": null
    },
    "algorithm": {
      "class_name": "environments.lane_follow_rsl:TerminalObservationPPO",
      "num_learning_epochs": 10,
      "num_mini_batches": 16,
      "learning_rate": 0.0003,
      "schedule": "fixed",
      "gamma": 0.999,
      "lam": 0.95,
      "entropy_coef": 0.01,
      "desired_kl": 0.02,
      "max_grad_norm": 0.5,
      "value_loss_coef": 0.5,
      "use_clipped_value_loss": false,
      "clip_param": 0.2,
      "normalize_advantage_per_mini_batch": true,
      "rnd_cfg": null,
      "symmetry_cfg": null
    }
  }
}
