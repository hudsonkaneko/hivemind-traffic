    def Xform "Looks"
    {
        def Material "Asphalt" (
            prepend apiSchemas = ["PhysicsMaterialAPI"]
        )
        {
            token outputs:surface.connect = </World/Looks/Asphalt/PreviewSurface.outputs:surface>
            float physics:dynamicFriction = 0.8
            float physics:restitution = 0
            float physics:staticFriction = 0.9

            def Shader "PreviewSurface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.07, 0.085, 0.1)
                float inputs:roughness = 0.92
                token outputs:surface
            }
        }

        def Material "AuxiliaryAsphalt"
        {
            token outputs:surface.connect = </World/Looks/AuxiliaryAsphalt/PreviewSurface.outputs:surface>

            def Shader "PreviewSurface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.095, 0.115, 0.13)
                float inputs:roughness = 0.92
                token outputs:surface
            }
        }

        def Material "Ground" (
            prepend apiSchemas = ["PhysicsMaterialAPI"]
        )
        {
            token outputs:surface.connect = </World/Looks/Ground/PreviewSurface.outputs:surface>
            float physics:dynamicFriction = 0.8
            float physics:restitution = 0
            float physics:staticFriction = 0.9

            def Shader "PreviewSurface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.16, 0.205, 0.15)
                float inputs:roughness = 0.92
                token outputs:surface
            }
        }

        def Material "WhitePaint"
        {
            token outputs:surface.connect = </World/Looks/WhitePaint/PreviewSurface.outputs:surface>

            def Shader "PreviewSurface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.85, 0.87, 0.86)
                float inputs:roughness = 0.92
                token outputs:surface
            }
        }

        def Material "YellowPaint"
        {
            token outputs:surface.connect = </World/Looks/YellowPaint/PreviewSurface.outputs:surface>

            def Shader "PreviewSurface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.95, 0.65, 0.12)
                float inputs:roughness = 0.92
                token outputs:surface
            }
        }
    }

    def Cube "Ground" (
        prepend apiSchemas = ["MaterialBindingAPI", "PhysicsCollisionAPI"]
    )
    {
        rel material:binding = </World/Looks/Ground>
        rel material:binding:physics = </World/Looks/Ground>
        rel physics:simulationOwner = </World/Physics/Scene>
        double size = 2
        float3 xformOp:scale = (411.65, 411.65, 0.5)
        double3 xformOp:translate = (0, 0, -0.8)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
    }

    def "Lighting"
    {
        def DistantLight "Sun"
        {
            float inputs:intensity = 2200
            float3 xformOp:rotateXYZ = (25, -30, 0)
            uniform token[] xformOpOrder = ["xformOp:rotateXYZ"]
        }

        def DomeLight "Sky"
        {
            float inputs:intensity = 450
        }
    }

    def "Cameras"
    {
        def Camera "Top"
        {
            float2 clippingRange = (0.1, 2000)
            float horizontalAperture = 8233
            token projection = "orthographic"
            float verticalAperture = 8233
            double3 xformOp:translate = (0, 0, 900)
            uniform token[] xformOpOrder = ["xformOp:translate"]
        }
    }
}

