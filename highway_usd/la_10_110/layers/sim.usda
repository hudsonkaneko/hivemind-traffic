#usda 1.0
(
    doc = """Simulation setup: materials, physics scene, lights, cameras, spawn points"""
    defaultPrim = "World"
    metersPerUnit = 1
    upAxis = "Z"
)

def Xform "World" (
    kind = "assembly"
)
{
    custom double geo:originLatitude = 34.038114
    custom double geo:originLongitude = -118.274017
    custom string geo:frame = "local ENU tangent plane, +X east, +Y north, metres"

    def Scope "Looks"
    {
        def Material "FreewayAsphalt"
        {
            token outputs:surface.connect = </World/Looks/FreewayAsphalt/Shader.outputs:surface>
            def Shader "Shader"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.075, 0.075, 0.08)
                float inputs:roughness = 0.85
                float inputs:metallic = 0
                token outputs:surface
            }
        }
        def Material "StreetAsphalt"
        {
            token outputs:surface.connect = </World/Looks/StreetAsphalt/Shader.outputs:surface>
            def Shader "Shader"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.16, 0.16, 0.17)
                float inputs:roughness = 0.9
                float inputs:metallic = 0
                token outputs:surface
            }
        }
        def Material "Concrete"
        {
            token outputs:surface.connect = </World/Looks/Concrete/Shader.outputs:surface>
            def Shader "Shader"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.63, 0.61, 0.57)
                float inputs:roughness = 0.8
                float inputs:metallic = 0
                token outputs:surface
            }
        }
        def Material "PaintWhite"
        {
            token outputs:surface.connect = </World/Looks/PaintWhite/Shader.outputs:surface>
            def Shader "Shader"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.92, 0.92, 0.9)
                float inputs:roughness = 0.6
                float inputs:metallic = 0
                token outputs:surface
            }
        }
        def Material "PaintYellow"
        {
            token outputs:surface.connect = </World/Looks/PaintYellow/Shader.outputs:surface>
            def Shader "Shader"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.95, 0.74, 0.08)
                float inputs:roughness = 0.6
                float inputs:metallic = 0
                token outputs:surface
            }
        }
        def Material "Ground"
        {
            token outputs:surface.connect = </World/Looks/Ground/Shader.outputs:surface>
            def Shader "Shader"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.44, 0.41, 0.36)
                float inputs:roughness = 0.95
                float inputs:metallic = 0
                token outputs:surface
            }
        }
        def Material "Grass"
        {
            token outputs:surface.connect = </World/Looks/Grass/Shader.outputs:surface>
            def Shader "Shader"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.24, 0.4, 0.17)
                float inputs:roughness = 0.95
                float inputs:metallic = 0
                token outputs:surface
            }
        }
        def Material "Building0"
        {
            token outputs:surface.connect = </World/Looks/Building0/Shader.outputs:surface>
            def Shader "Shader"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.74, 0.7, 0.62)
                float inputs:roughness = 0.85
                float inputs:metallic = 0
                token outputs:surface
            }
        }
        def Material "Building1"
        {
            token outputs:surface.connect = </World/Looks/Building1/Shader.outputs:surface>
            def Shader "Shader"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.56, 0.56, 0.59)
                float inputs:roughness = 0.85
                float inputs:metallic = 0
                token outputs:surface
            }
        }
        def Material "Building2"
        {
            token outputs:surface.connect = </World/Looks/Building2/Shader.outputs:surface>
            def Shader "Shader"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.82, 0.8, 0.76)
                float inputs:roughness = 0.85
                float inputs:metallic = 0
                token outputs:surface
            }
        }
        def Material "Metal"
        {
            token outputs:surface.connect = </World/Looks/Metal/Shader.outputs:surface>
            def Shader "Shader"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.55, 0.56, 0.58)
                float inputs:roughness = 0.45
                float inputs:metallic = 0
                token outputs:surface
            }
        }
        def Material "SignBack"
        {
            token outputs:surface.connect = </World/Looks/SignBack/Shader.outputs:surface>
            def Shader "Shader"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.3, 0.32, 0.31)
                float inputs:roughness = 0.6
                float inputs:metallic = 0
                token outputs:surface
            }
        }
        def Material "PhysAsphalt" (
            prepend apiSchemas = ["PhysicsMaterialAPI"]
        )
        {
            float physics:staticFriction = 0.9
            float physics:dynamicFriction = 0.8
            float physics:restitution = 0.0
        }
        def Material "PhysConcrete" (
            prepend apiSchemas = ["PhysicsMaterialAPI"]
        )
        {
            float physics:staticFriction = 0.7
            float physics:dynamicFriction = 0.6
            float physics:restitution = 0.05
        }
    }

    def PhysicsScene "PhysicsScene"
    {
        vector3f physics:gravityDirection = (0, 0, -1)
        float physics:gravityMagnitude = 9.81
    }

    def Scope "Lights"
    {
        def DistantLight "Sun"
        {
            float inputs:angle = 0.53
            float inputs:intensity = 3000
            color3f inputs:color = (1, 0.96, 0.9)
            float3 xformOp:rotateXYZ = (40, 0, 130)
            uniform token[] xformOpOrder = ["xformOp:rotateXYZ"]
        }
        def DomeLight "Sky"
        {
            float inputs:intensity = 900
            color3f inputs:color = (0.62, 0.76, 1)
        }
    }

    def Scope "Cameras"
    {
        def Camera "TopDown"
        {
            float focalLength = 18.0
            float2 clippingRange = (1, 20000)
            double3 xformOp:translate = (0, 0, 800)
            float3 xformOp:rotateXYZ = (0, 0, 0)
            uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:rotateXYZ"]
        }
        def Camera "TopDown_WithLoops"
        {
            float focalLength = 18.0
            float2 clippingRange = (1, 20000)
            double3 xformOp:translate = (0, 0, 2600)
            float3 xformOp:rotateXYZ = (0, 0, 0)
            uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:rotateXYZ"]
        }
        def Camera "Overview_FromSouth"
        {
            float focalLength = 24.0
            float2 clippingRange = (1, 20000)
            double3 xformOp:translate = (0, -650, 330)
            float3 xformOp:rotateXYZ = (62, 0, 0)
            uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:rotateXYZ"]
        }
        def Camera "Interchange_FromSE"
        {
            float focalLength = 24.0
            float2 clippingRange = (1, 20000)
