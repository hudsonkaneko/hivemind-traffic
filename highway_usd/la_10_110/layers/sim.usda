            float3 xformOp:rotateXYZ = (68, 0, 45)
            uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:rotateXYZ"]
        }
        def Camera "Interchange_FromNW"
        {
            float focalLength = 24.0
            float2 clippingRange = (1, 20000)
            double3 xformOp:translate = (-280, 280, 110)
            float3 xformOp:rotateXYZ = (68, 0, 225)
            uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:rotateXYZ"]
        }
        def Camera "Stack_LowAngle"
        {
            float focalLength = 20.0
            float2 clippingRange = (1, 20000)
            double3 xformOp:translate = (150, -170, 25)
            float3 xformOp:rotateXYZ = (84, 0, 40)
            uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:rotateXYZ"]
        }
    }

