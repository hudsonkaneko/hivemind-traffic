{
    def Xform "Signs"
    {
        def Scope "Looks"
        {
            def Material "M_000_0"
            {
                token outputs:surface.connect = </World/Signs/Looks/M_000_0/Surface.outputs:surface>
                def Shader "Surface"
                {
                    uniform token info:id = "UsdPreviewSurface"
                    color3f inputs:diffuseColor.connect = </World/Signs/Looks/M_000_0/Tex.outputs:rgb>
                    float inputs:roughness = 0.35
                    float inputs:metallic = 0
                    token outputs:surface
                }
                def Shader "Tex"
                {
                    uniform token info:id = "UsdUVTexture"
                    asset inputs:file = @./textures/signs/sign_000_0.png@
                    token inputs:sourceColorSpace = "sRGB"
                    token inputs:wrapS = "clamp"
                    token inputs:wrapT = "clamp"
                    float2 inputs:st.connect = </World/Signs/Looks/M_000_0/St.outputs:result>
                    float3 outputs:rgb
                }
                def Shader "St"
                {
                    uniform token info:id = "UsdPrimvarReader_float2"
