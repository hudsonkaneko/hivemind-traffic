+        neighbor(obs,18,44.1271,14.416)
+        details = reference_details(obs)
+        item = details['adjacent_risk_preview']['right']
+        required = legacy.required_gap(17.9,14.416)+3.
+        self.assertTrue(item['active'])
+        self.assertAlmostEqual(item['required_gap_with_buffer_m'],required)
+        self.assertAlmostEqual(item['risk_radius_m'],required+2.*17.9)
+        self.assertAlmostEqual(item['projected_gap_m'],44.1271-2.*(17.9-14.416))
