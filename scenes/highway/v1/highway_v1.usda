#usda 1.0
(
    defaultPrim = "World"
    metersPerUnit = 1
    upAxis = "Z"
)
def Xform "World"
{
    def Scope "Looks"
    {
        def Material "Asphalt"
        {
            token outputs:surface.connect = </World/Looks/Asphalt/Shader.outputs:surface>
            def Shader "Shader"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.055, 0.06, 0.065)
                float inputs:roughness = 0.88
                token outputs:surface
            }
        }
        def Material "WhitePaint"
        {
            token outputs:surface.connect = </World/Looks/WhitePaint/Shader.outputs:surface>
            def Shader "Shader"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.92, 0.92, 0.84)
                float inputs:roughness = 0.72
                token outputs:surface
            }
        }
        def Material "Grass"
        {
            token outputs:surface.connect = </World/Looks/Grass/Shader.outputs:surface>
            def Shader "Shader"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.09, 0.22, 0.075)
                float inputs:roughness = 0.95
                token outputs:surface
            }
        }
    }
